+async def _stackchan_gallery_sync_loop(stop: asyncio.Event) -> None:
+    """把 StackChan 的照片對帳進相簿(TICKET-H)。
+
+    對帳而不是在拍照當下推一筆:StackChan 有三條會改變狀態的路徑
+    (落地 / keep / 60 天到期),每條都掛通知等於改動它的既有行為,
+    而且漏一條就會在相簿留下指向已刪檔案的死卡。理由詳見 stackchan_gallery.py。
+    """
+    while not stop.is_set():
+        try:
+            with transaction() as conn:
+                result = stackchan_gallery.sync(
+                    conn,
+                    gallery_root=(settings.upload_dir / "gallery").resolve(),
+                    soft_cap_bytes=settings.gallery_soft_cap_bytes,
+                )
+            _delete_gallery_files(result.stale_files)
+            if result.changed or result.skipped_soft_cap:
+                logger.info("stackchan gallery sync %s", result.as_dict())
+        except Exception:
+            logger.exception("stackchan gallery sync failed")
+        try:
+            await asyncio.wait_for(stop.wait(), timeout=STACKCHAN_SYNC_SECONDS)
+        except TimeoutError:
+            pass
+

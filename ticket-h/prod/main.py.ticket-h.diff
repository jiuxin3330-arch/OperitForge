+@app.delete("/api/v2/gallery/photos/{photo_id}")
+async def delete_gallery_photo(
+    photo_id: str,
+    principal: Principal = Depends(require_csrf),
+) -> dict[str, Any]:
+    """刪除一張 StackChan 照片,連實體檔一起(TICKET-H R1)。
+
+    只開放 source_type='stackchan'。相簿裡其他來源(chat / screenshot /
+    legacy_chatnest)原本就沒有刪除功能,要不要一併開是另一個決定——
+    chat 照片還牽涉到訊息附件,不在本工單範圍內,所以這裡明確擋掉而不是預設放行。
+    """
+    with transaction() as conn:
+        row = conn.execute(
+            "SELECT source_type,source_ref,stored_name FROM gallery_photos WHERE id=?",
+            (photo_id,),
+        ).fetchone()
+        if not row:
+            raise HTTPException(status_code=404, detail="photo not found")
+        if str(row["source_type"]) != stackchan_gallery.SOURCE_TYPE:
+            raise HTTPException(
+                status_code=400,
+                detail="only StackChan photos can be deleted from the gallery",
+            )
+        source_ref = str(row["source_ref"] or "")
+        if source_ref:
+            try:
+                stackchan_gallery.delete_on_disk(source_ref)
+            except OSError as exc:
+                # 實體檔刪不掉就整筆退回,DB 列留著。
+                # 反過來做(DB 刪了、檔案還在)不是「至少刪掉一半」——
+                # 下一輪對帳會照著磁碟把它原封不動放回相簿,變成刪了又出現。
+                raise HTTPException(
+                    status_code=409,
+                    detail=f"cannot remove the photo file on disk: {exc.strerror or exc}",
+                ) from exc
+        conn.execute("DELETE FROM gallery_photos WHERE id=?", (photo_id,))
+        audit(
+            conn, principal.actor_id, "gallery.photo.delete", "gallery_photo", photo_id,
+            {"source_type": stackchan_gallery.SOURCE_TYPE, "source_ref": source_ref},
+        )
+        stored_name = str(row["stored_name"])
+    _delete_gallery_files([stored_name])
+    return {"ok": True}
+
